  "requirements": ["FR-USERPLUG-001", "FR-USERPLUG-002", "FR-USERPLUG-006", "FR-USERPLUG-009"],
  "tests": ["tools/verify.sh user-space", "tools/verify.sh plugin-lifecycle"],
  "migration": {
    "stage": 1,
    "mode": "migrated",
    "from": "user-space/demo-ns/hello/",
    "impl": "code/index.mjs",
