#!/bin/sh
# Product lifecycle entry; all application behavior is composed by host/product.mjs.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"
ACTION=${1:-up}
[ $# -eq 0 ] || shift
PORT=${QUOTAGENT_WEBUI_PORT:-8093}
while [ $# -gt 0 ]; do
  case "$1" in --port) PORT=$2; shift 2;; *) echo "Unknown option: $1" >&2; exit 2;; esac
done
RUN_DIR="$ROOT/tmp/product-run"
PID_FILE="$RUN_DIR/$PORT.pid"
LOG_FILE="$RUN_DIR/$PORT.log"
URL="http://127.0.0.1:$PORT/quotagent/"
mkdir -p "$RUN_DIR"
build() {
  if [ ! -d host/node_modules ]; then npm ci --prefix host --no-audit --no-fund; fi
  npm --prefix host run build
}
healthy() { curl -fsS --max-time 3 "$URL"api/health >/dev/null 2>&1; }
case "$ACTION" in
  build) build;;
  up)
    if healthy; then printf 'Quotagent is running at %s\n' "$URL"; exit 0; fi
    build
    QUOTAGENT_WEBUI_PORT="$PORT" nohup node host/product.mjs >"$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
    tries=0
    while [ "$tries" -lt 30 ]; do
      if healthy; then printf 'Quotagent is ready: %s\nDemo accounts and credentials: README.md\n' "$URL"; exit 0; fi
      if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then cat "$LOG_FILE"; exit 1; fi
      sleep 1; tries=$((tries + 1))
    done
    echo 'Startup timed out; see ./run logs' >&2; exit 1;;
  down)
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then kill "$PID"; fi
      rm -f "$PID_FILE"
      echo 'Stopped the process started by ./run.'
    else echo 'No ./run-managed process. A workspace-managed service is controlled by ws-gateway.'; fi;;
  status) if healthy; then printf 'Running: %s\n' "$URL"; else echo 'Not running'; exit 1; fi;;
  logs) if [ -f "$LOG_FILE" ]; then tail -n 60 "$LOG_FILE"; else echo 'No ./run log; workspace-managed service logs are available through ws-gateway.'; fi;;
  doctor)
    node --version
    python3 --version
    npm --version
    if [ -f host/node_modules/cordis/package.json ]; then node -e "console.log('Cordis '+require('./host/node_modules/cordis/package.json').version)"; else echo 'Dependencies will be installed on ./run up'; fi
    printf 'App: %s\n' "$URL"
    if healthy; then echo 'Service healthy'; else echo 'Service not started'; fi;;
  *) echo 'Usage: ./run up|down|status|logs|doctor|build [--port PORT]' >&2; exit 2;;
esac
